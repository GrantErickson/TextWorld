# Dependencies — restored by `npm install` from package-lock.json.
node_modules/

# Build output — regenerated by `npm run build`.
dist/
dist-ssr/
*.local

# Vite / TypeScript caches
.vite/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files. Commit a .env.example instead if one is ever needed.
.env
.env.local
.env.*.local

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Claude Code local overrides (machine-specific; shared config stays tracked)
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
